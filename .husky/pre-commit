set -e
# Fail closed: no skipped installs. Manifest changes require sync:ecp (core sibling packs).
if git diff --cached --name-only | grep -qE '(^|/)(pnpm-lock\.yaml|package\.json|pnpm-workspace\.yaml)$'; then
  pnpm run sync:ecp
  if [ -f pnpm-lock.yaml ]; then
    git add pnpm-lock.yaml || true
  fi
fi
pnpm exec lint-staged
pnpm run preflight
