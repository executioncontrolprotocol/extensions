{
  "name": "@executioncontrolprotocol/extensions-workspace",
  "version": "0.1.0",
  "description": "First-party vendor extensions for Execution Control Protocol (ECP)",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "clean": "node scripts/clean-dist.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run build && npm run lint && npm run test",
    "publish:workspaces": "node scripts/publish-workspaces.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.0.18",
    "yaml": "^2.9.0"
  }
}
